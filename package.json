{
  "name": "@jwilger/tiber",
  "version": "1.2.0",
  "description": "Deterministic development workflows and shared task tracking for stock Pi",
  "license": "MIT OR Apache-2.0",
  "author": "John Wilger",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "workflow",
    "task-tracking",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwilger/tiber.git"
  },
  "bugs": {
    "url": "https://github.com/jwilger/tiber/issues"
  },
  "homepage": "https://github.com/jwilger/tiber#readme",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "files": [
    "dist/",
    "docs/",
    "prompts/",
    "skills/",
    "workflows/",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/tiber-status.md"
    ]
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "node --eval \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:acceptance": "vitest run tests/acceptance",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify:fast": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run clean && npm run build",
    "test:mutation": "stryker run",
    "verify:package": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2 <1",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1",
    "@earendil-works/pi-tui": ">=0.84.2 <1",
    "typebox": ">=1.3.7 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.1",
    "eslint": "10.9.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
