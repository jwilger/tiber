{
  "name": "@jwilger/tiber",
  "version": "1.2.2",
  "description": "Pi-native development system with a Rust-authoritative policy and workflow engine",
  "license": "MIT OR Apache-2.0",
  "author": "John Wilger",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwilger/tiber.git"
  },
  "bugs": {
    "url": "https://github.com/jwilger/tiber/issues"
  },
  "homepage": "https://github.com/jwilger/tiber#readme",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "files": [
    "CHANGELOG.md",
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "PLAN.md",
    "README.md",
    "docs",
    "extensions",
    "scripts",
    "skills",
    "src"
  ],
  "keywords": [
    "pi-package",
    "development",
    "workflow",
    "tiber"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "dev:install": "node scripts/dev-install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "runtime:install": "bash scripts/install-runtime.sh",
    "runtime:remove": "rm -rf .runtime",
    "test:dev-install": "node --test tests/dev-install.test.mjs",
    "test:rust": "cargo test --locked",
    "verify": "npm run format:check && npm run test:dev-install && npm run verify:rust && npm run verify:package",
    "verify:package": "npm pack --dry-run",
    "verify:rust": "cargo fmt --all --check && cargo clippy --all-targets -- -D warnings && cargo test --locked"
  },
  "devDependencies": {
    "lefthook": "2.1.10",
    "prettier": "3.9.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
